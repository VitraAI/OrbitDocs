{
	# Certificates are issued on demand, only for hosts the platform knows
	# (its own domain, project subdomains, verified custom domains).
	on_demand_tls {
		ask http://platform:8080/api/domains/allowed
	}
}

# Trying it on your machine (PLATFORM_DOMAIN=localhost): public CAs don't issue
# for localhost, so these get certificates from Caddy's own CA (its root is
# /data/caddy/pki/authorities/local/root.crt in this container).
localhost, *.localhost {
	tls internal {
		on_demand
	}
	reverse_proxy platform:8080
}

https:// {
	tls {
		on_demand
	}
	reverse_proxy platform:8080
}

http:// {
	redir https://{host}{uri}
}
