{
  "name": "@orbitdocs/platform",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted OrbitDocs platform: projects, registry, publishing, hosting, teams, analytics and audit.",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@orbitdocs/ai": "workspace:*",
    "@orbitdocs/auth": "workspace:*",
    "@orbitdocs/openapi": "workspace:*",
    "@stoplight/spectral-core": "^1.24.0",
    "@stoplight/spectral-parsers": "^1.0.5",
    "@stoplight/spectral-rulesets": "^1.23.0",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "pg-boss": "^12.36.0",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tar": "^7.5.22",
    "undici": "7.29.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "~6.0.3",
    "vitest": "^4.0.0"
  }
