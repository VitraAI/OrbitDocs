# OrbitDocs platform — copy to .env, fill in, then `docker compose up -d`.
#   cp .env.example .env
# Docker Compose reads .env for the ${…} values in docker-compose.yml, and the
# platform container loads the whole file, so every variable below reaches it.
# Never commit .env: it holds secrets.

# ─── Required ────────────────────────────────────────────────────────────────

# Signs dashboard sessions and encrypts stored Git tokens. 32+ random characters.
# Generate one with: openssl rand -hex 32
PLATFORM_SECRET=

# The first admin, created on start if no user has this email yet.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

# ─── Domain and URLs ─────────────────────────────────────────────────────────

# Dashboard host. Sites are served at <project>.<domain> and previews at
# <project>--<pr-label>.<domain>. Point <domain> and *.<domain> at this server.
# Default: localhost (dashboard at https://localhost, sites at https://<project>.localhost).
PLATFORM_DOMAIN=localhost

# Public URL of the dashboard, used in links, webhooks and commit statuses.
# Default under Docker Compose: https://<PLATFORM_DOMAIN>
# PLATFORM_URL=https://docs.example.com

# ─── Database ────────────────────────────────────────────────────────────────

# Password of the bundled Postgres container. Default: orbitdocs.
# Change it before the first start; the database keeps the password it was created with.
POSTGRES_PASSWORD=orbitdocs

# Only when you use your own Postgres instead of the bundled one (then remove the
# postgres service and the platform's depends_on from docker-compose.yml).
# Default: the bundled container.
# DATABASE_URL=postgres://orbitdocs:secret@db.example.com:5432/orbitdocs

# ─── Dashboard sign-in with SSO (optional) ───────────────────────────────────

# JSON list of sign-in presets: google, microsoft, okta, auth0, clerk, keycloak.
# Each names the variable that holds its client secret (clientSecretEnv); add that
# variable below. Email + password keeps working alongside SSO.
# PLATFORM_SSO=[{"type":"okta","domain":"acme.okta.com","clientId":"0oa123","clientSecretEnv":"OKTA_CLIENT_SECRET"}]
# OKTA_CLIENT_SECRET=

# ─── Provisioning (optional) ─────────────────────────────────────────────────

# Turns on SCIM 2.0 at /scim/v2 with this bearer token (Okta, Entra ID, …).
# Generate one with: openssl rand -hex 32
# SCIM_TOKEN=

# Hosted sites can't reach private, loopback or link-local addresses (your
# database, internal services, the cloud metadata endpoint) or this platform's
# own hosts. List the internal hosts they may still reach, such as a Keycloak on
# your network: hostnames, *.suffixes, IPs or CIDRs, comma-separated.
# SITE_OUTBOUND_ALLOW=keycloak.internal,10.0.0.20

# ─── Git sync builds (optional) ──────────────────────────────────────────────

# Builds each platform instance runs at once. Default: 1.
# BUILD_CONCURRENCY=1

# Time limit for each build step (clone, install, build), in milliseconds.
# Default: 900000 (15 minutes).
# BUILD_TIMEOUT_MS=900000

# ─── Set by docker-compose.yml (change only outside Docker) ─────────────────
# PORT=8080          Port the platform listens on. Default: 8080.
# DATA_DIR=/data     Where published sites and build folders live. Default: ./data (/data in the image).

# Secrets for hosted docs sites (their SSO client secrets, Ask AI keys) do not go here:
# sites never read this environment. Set them per project under Settings → Environment.
