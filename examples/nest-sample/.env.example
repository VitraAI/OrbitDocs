# Orbit Travel sample: every environment variable the sample reads.
# Copy to `.env` (git-ignored) and fill in. Placeholders only; never commit real secrets.
#
# The Nest app does not load .env files itself: start it with
#   node --env-file=.env dist/main.js
# (or `set -a; . ./.env; set +a` first). The docs app (Next.js, in docs/) loads
# docs/.env* on its own for `orbitdocs dev` / `orbitdocs build`.

# ── Nest API (src/main.ts, src/docs-hook) ─────────────────────────────────────
# Port the API (and the built docs at /docs) listen on. Optional, default 3010.
PORT=3010

# ── OAuth (src/common/auth.ts, POST /v1/oauth/token) ──────────────────────────
# Client id accepted by the token endpoint. Optional, default oc_test_orbit_demo.
ORBIT_OAUTH_CLIENT_ID=oc_test_orbit_demo
# Secret for that client. Optional, default ocs_test_5e8d2a7c9b1f (a public demo value;
# change it, and the docs config's `bearer` description, if the sample is reachable by others).
ORBIT_OAUTH_CLIENT_SECRET=ocs_test_5e8d2a7c9b1f

# ── Docs site / output mode (docs/orbitdocs.config.ts) ────────────────────────
# `server` builds the docs as a Next server (Vercel, Docker); anything else builds
# static files the Nest app serves at /docs. Optional, default static.
ORBITDOCS_MODE=static

# ── Private docs: SSO + app session (docs config → access; enforced by mountOrbitDocs) ──
# Signs reader sessions (access.session.secretEnv). Required whenever the docs are
# served with `access` configured, as in this sample; at least 32 characters
# (e.g. `openssl rand -hex 32`). No default.
ORBITDOCS_AUTH_SECRET=replace-with-a-random-string-of-at-least-32-chars
# Client secret of the "Orbit SSO" Keycloak provider (providers[].clientSecretEnv).
# Required to sign in with SSO; the local mock IdP accepts any value. No default.
MOCK_OIDC_SECRET=replace-me
# Shared HMAC secret for the personalization hook: the docs sign the request with it
# (access.personalization.secretEnv) and the Nest app verifies it
# (src/docs-hook). Required for pre-filled API keys after sign-in; without it the
# hook answers 401. No default.
DOCS_HOOK_SECRET=replace-me
# The Supabase-style app session uses the mock IdP's public keys, so it needs no
# secret here (set access.appSession.jwtSecretEnv only for legacy shared-secret projects).

# ── Mock identity provider (scripts/mock-idp.mjs, `pnpm mock-idp`) ─────────────
# Port of the mock Keycloak realm + Supabase-style sign-in. Optional, default 8090
# (the docs config points at http://localhost:8090).
MOCK_IDP_PORT=8090
# Email every SSO sign-in returns. Optional, default ada@orbit-travel.example (staff group).
MOCK_EMAIL=ada@orbit-travel.example
# Display name for SSO sign-ins. Optional, default Ada Lovelace.
MOCK_NAME=Ada Lovelace
# Comma-separated IdP groups for SSO sign-ins. Optional, default empty.
MOCK_GROUPS=
# Email pre-filled on the mock product sign-in page. Optional, default sam@orbit-travel.example.
MOCK_APP_EMAIL=sam@orbit-travel.example

# ── Ask AI (docs config → ai; scripts/mock-llm.mjs) ───────────────────────────
# API key for the Ask AI model (ai.apiKeyEnv). Required for Ask AI and the docs MCP
# answers; the local mock LLM accepts any value. No default.
DOCS_LLM_KEY=replace-me
# Port of the mock OpenAI-compatible model (`pnpm mock-llm`). Optional, default 8091
# (the docs config points at http://localhost:8091/v1).
MOCK_LLM_PORT=8091

# ── SDKs / mock / CLI ─────────────────────────────────────────────────────────
# `orbitdocs mock` and `orbitdocs sdk test` read no environment variables (port and
# handlers come from the docs config). The generated SDK code samples read these in
# YOUR code, not in the sample: API_KEY (TypeScript, Python) and BEARER_TOKEN (Python).
# API_KEY=otk_test_4f9a2c1b8e7d6a5f
# BEARER_TOKEN=oat_test_replace-me
# `orbitdocs publish` only: OrbitDocs platform URL and deploy token. Optional.
# ORBITDOCS_PLATFORM_URL=https://docs-platform.example
# ORBITDOCS_TOKEN=replace-me
