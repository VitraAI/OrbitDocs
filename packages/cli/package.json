{
  "name": "orbitdocs",
  "version": "0.1.0",
  "description": "OrbitDocs CLI: init, dev, extract, check, build and deploy API documentation sites.",
  "license": "MIT",
  "author": "Vitra.ai (https://vitra.ai)",
  "homepage": "https://github.com/VitraAI/OrbitDocs/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
