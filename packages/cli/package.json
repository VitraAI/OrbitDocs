    "@orbitdocs/auth": "workspace:*",
    "yaml": "^2.8.1",
    "@orbitdocs/ai": "workspace:*",
    "@hey-api/openapi-ts": "^0.99.0",
    "@hono/node-server": "^2.1.3",
    "@openapitools/openapi-generator-cli": "^2.41.0",
    "@scalar/mock-server": "^0.17.3",
    "@stoplight/spectral-core": "^1.24.0",
    "@stoplight/spectral-parsers": "^1.0.5",
    "@stoplight/spectral-rulesets": "^1.23.0",
    "@stoplight/spectral-ruleset-bundler": "^1.8.0",
    "typescript": "~6.0.3",
