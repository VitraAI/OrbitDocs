{
  "name": "@orbitdocs/core",
  "version": "0.1.0",
  "description": "OrbitDocs config schema, loader and shared types.",
  "license": "MIT",
  "author": "Vitra.ai (https://vitra.ai)",
  "homepage": "https://github.com/VitraAI/OrbitDocs/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VitraAI/OrbitDocs.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/VitraAI/OrbitDocs/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./loader": {
      "types": "./dist/loader.d.ts",
      "import": "./dist/loader.js",
      "require": "./dist/loader.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "jiti": "^2.6.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
