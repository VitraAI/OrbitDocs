{
  "name": "@vitra-ai/orbitdocs-ui",
  "version": "0.2.0",
  "description": "OrbitDocs React components: Scalar-style API reference, MDX components and the HeroUI theme.",
  "license": "MIT",
  "author": "Vitra.ai (https://vitra.ai)",
  "homepage": "https://github.com/VitraAI/OrbitDocs/tree/main/packages/ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VitraAI/OrbitDocs.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/VitraAI/OrbitDocs/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./reference": {
      "types": "./dist/reference/index.d.ts",
      "default": "./dist/reference/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./styles.css": "./styles.css",
    "./api-client": {
      "types": "./dist/api-client/index.d.ts",
      "default": "./dist/api-client/index.js"
    },
    "./api-client/server": {
      "types": "./dist/api-client/server.d.ts",
      "default": "./dist/api-client/server.js"
    },
    "./ask-ai": {
      "types": "./dist/ask-ai/index.d.ts",
      "default": "./dist/ask-ai/index.js"
    },
    "./palette-orbit.css": "./palette-orbit.css",
    "./palette-fumadocs.css": "./palette-fumadocs.css"
  },
  "files": [
    "dist",
    "styles.css",
    "palette-orbit.css",
    "palette-fumadocs.css"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vitra-ai/orbitdocs-openapi": "workspace:*",
    "@scalar/snippetz": "^0.10.5",
    "marked": "^18.0.14",
    "react-icons": "^5.7.0",
    "shiki": "^4.5.0"
  },
  "peerDependencies": {
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "fumadocs-core": "^16.15.0",
    "fumadocs-ui": "^16.15.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fumadocs-core": "16.15.18",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.18",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
