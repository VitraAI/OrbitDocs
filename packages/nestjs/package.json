{
  "name": "@vitra-ai/orbitdocs-nestjs",
  "version": "0.1.0",
  "description": "OrbitDocs for NestJS: @Docs* decorators, preview-mode spec extraction, and serving the built docs from your app.",
  "license": "MIT",
  "author": "Vitra.ai (https://vitra.ai)",
  "homepage": "https://github.com/VitraAI/OrbitDocs/tree/main/packages/nestjs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VitraAI/OrbitDocs.git",
    "directory": "packages/nestjs"
  },
  "bugs": {
    "url": "https://github.com/VitraAI/OrbitDocs/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./extract-cli": "./dist/extract-cli.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@vitra-ai/orbitdocs-openapi": "workspace:*",
    "@vitra-ai/orbitdocs-auth": "workspace:*",
    "@vitra-ai/orbitdocs-ai": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10",
    "@nestjs/core": ">=10",
    "@nestjs/swagger": ">=7",
    "reflect-metadata": ">=0.1"
  },
  "devDependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/testing": "^12.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsup": "^8.5.1",
    "unplugin-swc": "^2.0.0",
    "@swc/core": "^1.16.13"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
